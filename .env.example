# =============================================================================
# Plantilla de configuración. Copiar a .env y completar con valores reales.
#   cp .env.example .env
# El archivo .env NO se versiona. Ningún valor real vive en este archivo.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API de Mercado Público (ChileCompra)
# -----------------------------------------------------------------------------

# Ticket de la API. Se solicita con Clave Única en https://www.chilecompra.cl/api/
# Es personal e intransferible. Tope declarado: 10.000 requests diarios.
MP_API_TICKET=

# Base de la API de datos abiertos de Mercado Público.
MP_API_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico

# Base del sitio web público, usada solo para la ficha de detalle y los adjuntos
# que la API no expone.
MP_WEB_BASE_URL=https://www.mercadopublico.cl

# -----------------------------------------------------------------------------
# 2. Identificación honesta
# -----------------------------------------------------------------------------

# User-Agent con medio de contacto real. No se falsea ni se imita un navegador:
# si el operador de la fuente quiere contactarnos, debe poder hacerlo.
# Formato: nombre-proyecto/version (+contacto)
USER_AGENT=demo-scrap/0.1 (+mailto:tu.correo@ejemplo.cl)

# Correo de contacto expuesto en el User-Agent y en la documentación.
CONTACT_EMAIL=tu.correo@ejemplo.cl

# -----------------------------------------------------------------------------
# 3. Throttling y reintentos
# -----------------------------------------------------------------------------

# Segundos de espera entre requests. Conservador a propósito: la fuente es un
# servicio público y el tope diario es finito.
REQUEST_DELAY_SECONDS=2.0

# Requests concurrentes hacia el mismo dominio. 1 = estrictamente secuencial.
CONCURRENT_REQUESTS=1

# Autothrottle: ajusta la espera según la latencia observada del servidor.
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_TARGET_CONCURRENCY=1.0

# Timeout por request, en segundos.
REQUEST_TIMEOUT_SECONDS=30

# Reintentos ante fallo transitorio.
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=2.0
# Códigos HTTP que se reintentan. El resto falla de inmediato y se registra.
RETRY_HTTP_CODES=429,500,502,503,504

# Tope de requests por corrida. Cortafuegos contra una corrida descontrolada
# que se coma el cupo diario del ticket.
MAX_REQUESTS_PER_RUN=2000

# -----------------------------------------------------------------------------
# 4. Caché de respuestas en desarrollo
# -----------------------------------------------------------------------------

# Con la caché activa, iterar sobre el parseo no vuelve a golpear la fuente.
# Es la variable que más acelera el bucle de verificación.
HTTP_CACHE_ENABLED=true
HTTP_CACHE_DIR=data/cache/http
# Vigencia de la caché en segundos. 0 = no expira.
HTTP_CACHE_EXPIRATION_SECONDS=86400

# -----------------------------------------------------------------------------
# 5. Muestra de extracción
# -----------------------------------------------------------------------------

# La extracción parte de ÓRDENES DE COMPRA, no de licitaciones: la API no permite
# ir de licitación a OC (rechaza el parámetro) y el listado de OC no trae
# CodigoLicitacion. Ver docs/01-analisis.md § 3.5.
#
# Tres fechas separadas en el año, elegidas MIDIENDO el volumen de cada una.
# Descartada 2025-07-16: es feriado en Chile (Virgen del Carmen) y trae 555
# órdenes contra las ~9.000 de un día hábil normal.
#
#   2025-01-15  7.471 órdenes, 4.004 enlazables
#   2025-05-15  9.206 órdenes, 4.047 enlazables
#   2025-10-15  9.375 órdenes, 4.000 enlazables
FECHAS_OC=2025-01-15,2025-05-15,2025-10-15

# La muestra incluye AMBOS mundos a propósito.
#
# Con proceso: tipos SE y CC, que traen CodigoLicitacion poblado.
OC_CON_PROCESO_POR_FECHA=100
TIPOS_OC_CON_LICITACION=SE,CC
#
# Sin proceso: compra ágil (AG), convenio marco (CM) y trato directo (TD). No
# nacen de una licitación y son el 56% de las órdenes. Se incluyen porque la
# pregunta de negocio 5 —qué proporción del gasto se ejecuta sin licitación—
# depende de ellas, y porque sin ellas el caso 'OC huérfana' del modelo nunca
# se ejercitaría.
OC_SIN_PROCESO_POR_FECHA=50
TIPOS_OC_SIN_LICITACION=AG,CM,TD,CT

# Presupuesto de requests: 3 listados + 450 detalles de OC + hasta 300
# licitaciones ~= 750, contra un cupo diario de 10.000.

# Estados de orden de compra, medidos sobre 9.206 del 15-05-2025:
#   12 Recepción Conforme  71,1%      6 Aceptada             24,3%
#    9 Cancelada            3,6%      4 Enviada a proveedor   1,0%
#    5 En proceso           0,03%
# Se ingestan TODAS y el estado se guarda. El gasto se mide de dos formas:
#   comprometido = la orden existe y no fue anulada     (96,4%)
#   ejecutado    = el proveedor acepto o entrego        (95,4%)
# La brecha son las ordenes recien enviadas o en proceso, cuyo destino no se
# sabe. Un CLM distingue esas dos cosas y la diferencia es informacion.
ESTADOS_COMPROMETIDO=4,5,6,12
ESTADOS_EJECUTADO=6,12

# Las órdenes de compra se publican con 1 a 2 meses de rezago. Partiendo desde
# la OC el problema desaparece —si la orden existe, su licitación también— pero
# el margen se conserva para validar coherencia de fechas.
OC_PUBLICATION_LAG_DAYS=60

# 6. Capa de inferencia (extracción sobre texto no estructurado)
# -----------------------------------------------------------------------------

# Adaptador activo: local | hosted
# Local por defecto. La decisión es arquitectónica: un CLM enterprise procesa
# contratos confidenciales y la pregunta comercial siempre es a dónde van esos
# documentos. Los datos de esta demo son públicos, así que aquí no es una
# necesidad real, es una postura de diseño que se puede defender.
INFERENCE_PROVIDER=local

# --- Adaptador local (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Adaptador hosted (alternativa conmutable) ---
# Se deja vacío mientras el proveedor activo sea local.
HOSTED_INFERENCE_API_KEY=
HOSTED_INFERENCE_MODEL=claude-sonnet-5

# Parámetros comunes de inferencia.
INFERENCE_TEMPERATURE=0.0
INFERENCE_MAX_TOKENS=2048
INFERENCE_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# 7. Umbrales de calidad que hacen fallar la corrida
# -----------------------------------------------------------------------------

# Porcentaje máximo de registros que pueden caer en cuarentena antes de que la
# corrida se declare fallida. Por encima de esto no hay un dato malo: hay un
# parser roto o una fuente que cambió.
MAX_QUARANTINE_RATE=0.05

# Mínimo de registros esperados en una corrida. Menos que esto sugiere que el
# descubrimiento falló en silencio.
MIN_RECORDS_PER_RUN=50

# Porcentaje mínimo de campos obligatorios presentes en los registros válidos.
MIN_REQUIRED_FIELD_COVERAGE=0.98

# Porcentaje máximo de requests fallidos tolerado en una corrida.
MAX_REQUEST_FAILURE_RATE=0.02

# Porcentaje mínimo de salidas del modelo que deben ser JSON parseable contra el
# esquema. Por debajo de esto la capa de inferencia se considera degradada.
MIN_INFERENCE_PARSE_RATE=0.90

# -----------------------------------------------------------------------------
# 8. Operación
# -----------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DATA_DIR=data
